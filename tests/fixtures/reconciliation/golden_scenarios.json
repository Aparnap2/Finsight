{
  "schema_version": "1.0",
  "description": "Independently defined golden reconciliation scenarios for FinSight E2E verification. Expected values are hand-calculated, NOT generated by the reconciliation engine at test time. A human must verify these before treating them as authoritative.",
  "currency": "USD",
  "scenarios": {
    "fee_discrepancy": {
      "description": "SaaS payment with processing fee. Invoice and charge match on gross; bank deposit is net of fee.",
      "inputs": {
        "invoices": "invoice_id,amount,currency,issued_at\ninv_a,1000.00,USD,2026-09-01\ninv_b,500.00,USD,2026-09-02\n",
        "stripe": "charge_id,amount,currency,created_at,fee\nch_a,1000.00,USD,2026-09-01,29.00\nch_b,500.00,USD,2026-09-02,10.00\n",
        "bank": "deposit_id,amount,posted_at\ndep_1,1471.00,2026-09-03\n"
      },
      "expected": {
        "import": {
          "invoice_accepted": 2,
          "stripe_accepted": 2,
          "bank_accepted": 1,
          "invalid_rows": 0
        },
        "validation": {
          "status": "READY"
        },
        "reconciliation": {
          "match_count": 2,
          "exception_count": 3,
          "exception_code": "I-FEE-DRIFT",
          "exception_severity": "MEDIUM",
          "allocation_count": 1,
          "allocated_total": "1461.00",
          "open_balance": "0.00",
          "unallocated_deposit": "0.00",
          "fee_total": "39.00"
        },
        "eligibility": "ELIGIBLE",
        "investigation": {
          "abstained": false,
          "evidence_subset": true
        },
        "human_decision": {
          "decision_type": "APPROVE",
          "new_status": "RESOLVED"
        },
        "export": {
          "must_contain": ["1471.00", "I-FEE-DRIFT"]
        }
      }
    },
    "balanced_payout": {
      "description": "Exact match: invoice and charge amounts agree, bank deposit equals net payout. No exception.",
      "inputs": {
        "invoices": "invoice_id,amount,currency,issued_at,fee\ninv_x,500.00,USD,2026-10-01,10.00\n",
        "stripe": "charge_id,amount,currency,created_at,fee\nch_x,500.00,USD,2026-10-01,10.00\n",
        "bank": "deposit_id,amount,posted_at\ndep_x,490.00,2026-10-02\n"
      },
      "expected": {
        "import": {
          "invoice_accepted": 1,
          "stripe_accepted": 1,
          "bank_accepted": 1,
          "invalid_rows": 0
        },
        "validation": {
          "status": "READY"
        },
        "reconciliation": {
          "match_count": 1,
          "exception_count": 0,
          "allocation_count": 1,
          "allocated_total": "490.00",
          "open_balance": "0.00"
        },
        "eligibility": null,
        "investigation": null,
        "human_decision": null,
        "export": {
          "must_contain": ["490.00"]
        }
      }
    }
  }
}