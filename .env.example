# Copy to .env for local use: `cp .env.example .env`
# docker-compose.staging.yml requires this file to exist (env_file, required:
# true). Values here are placeholders, never real credentials.
POSTGRES_URI=postgresql://finsight:finsight@localhost:5432/finsight
# Optional: separate migration role. Empty means "same as POSTGRES_URI".
MIGRATION_POSTGRES_URI=
QDRANT_URL=http://localhost:6333
REDIS_URL=redis://localhost:6380/0
OPENAI_API_KEY=sk-your-key-here
# LLM providers: blank means no live calls. The deterministic reconciliation
# path never needs these; live_llm tests are additionally gated on
# FINSIGHT_ALLOW_LIVE_LLM=1.
GROQ_API_KEY=
OPENROUTER_API_KEY=
POOLSIDE_API_KEY=
LITELLM_PROXY_URL=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
STRIPE_WEBHOOK_SECRET=whsec-your-endpoint-secret
STRIPE_TENANT_MAP={"acct_123": "tenant-acme"}
