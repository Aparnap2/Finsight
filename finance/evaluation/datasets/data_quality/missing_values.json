{
  "metadata": {
    "id": "missing_values",
    "name": "Missing Values in Account Data",
    "category": "data_quality",
    "subcategory": "missing_data",
    "description": "Some accounts have null values for actual or budget. The system should handle gracefully and only process accounts with valid data.",
    "tags": ["missing_data", "edge_case", "null_handling"],
    "difficulty": "intermediate"
  },
  "input": {
    "query": "Analyse budget variances for all accounts in Q1 2026",
    "context": {
      "accounts": [
        {"id": "4010", "name": "Product Revenue", "actual": 500000, "budget": 480000},
        {"id": "4020", "name": "Service Revenue", "actual": null, "budget": 300000},
        {"id": "5010", "name": "Payroll", "actual": 250000, "budget": null},
        {"id": "5020", "name": "Marketing", "actual": 100000, "budget": 120000}
      ]
    },
    "spreadsheet_data": {},
    "variances": []
  },
  "expected": {
    "planning": {
      "required_intents": ["compute_variance", "handle_missing_data"],
      "forbidden_intents": [],
      "min_actions": 2,
      "max_actions": 6,
      "max_replans": 1
    },
    "execution": {
      "min_success_rate": 0.8,
      "max_retries_total": 1,
      "max_failed_actions": 1
    },
    "verification": {
      "max_unsupported": 1,
      "max_contradictions": 0,
      "min_evidence": 1,
      "min_confidence": 0.6
    },
    "reflection": {
      "expected_decision": "finalize",
      "max_gaps": 1
    },
    "output": {
      "variances": [
        {"account_id": "4010", "variance_amount": 20000, "variance_pct": 4.17},
        {"account_id": "5020", "variance_amount": -20000, "variance_pct": -16.67}
      ],
      "kpis": [
        {"name": "Revenue Growth", "value": 4.17},
        {"name": "Marketing Under-run", "value": -16.67}
      ],
      "report_sections": {
        "executive_summary": "revenue 4% above budget, marketing 17% under budget; 2 accounts excluded due to missing data"
      },
      "required_claims": ["Missing data detected", "Partial analysis performed"],
      "forbidden_claims": ["All accounts analysed", "Complete data available"]
    }
  }
}
