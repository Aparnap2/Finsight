{
  "metadata": {
    "id": "retry_scenario",
    "name": "Transient Failure Retry Scenario",
    "category": "runtime_behaviour",
    "subcategory": "retry_scenario",
    "description": "External data source has transient failures. The system must retry and gracefully handle partial data availability.",
    "tags": ["retry", "resilience", "reliability"],
    "difficulty": "advanced"
  },
  "input": {
    "query": "Analyse budget variances with intermittent data source",
    "context": {
      "accounts": [
        {"id": "4010", "name": "Revenue", "actual": 1000000, "budget": 950000},
        {"id": "5010", "name": "Payroll", "actual": 500000, "budget": 480000},
        {"id": "5020", "name": "Marketing", "actual": 150000, "budget": 200000}
      ],
      "data_source_flaky": true,
      "max_retries_available": 3
    },
    "spreadsheet_data": {},
    "variances": []
  },
  "expected": {
    "planning": {
      "required_intents": ["compute_variance", "retry_failed_actions"],
      "forbidden_intents": [],
      "min_actions": 3,
      "max_actions": 8,
      "max_replans": 1
    },
    "execution": {
      "min_success_rate": 0.8,
      "max_retries_total": 3,
      "max_failed_actions": 1
    },
    "verification": {
      "max_unsupported": 1,
      "max_contradictions": 0,
      "min_evidence": 1,
      "min_confidence": 0.6
    },
    "reflection": {
      "expected_decision": "finalize",
      "max_gaps": 1
    },
    "output": {
      "variances": [
        {"account_id": "4010", "variance_amount": 50000, "variance_pct": 5.26},
        {"account_id": "5010", "variance_amount": 20000, "variance_pct": 4.17},
        {"account_id": "5020", "variance_amount": -50000, "variance_pct": -25.0}
      ],
      "kpis": [
        {"name": "Revenue Growth", "value": 5.26},
        {"name": "Marketing Under-run", "value": -25.0}
      ],
      "report_sections": {
        "executive_summary": "analysis completed with retries; revenue 5% above budget despite intermittent data source"
      },
      "required_claims": ["Retry mechanism activated", "Data source had transient failures"],
      "forbidden_claims": ["All data fetched on first attempt"]
    }
  }
}
